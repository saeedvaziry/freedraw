APP_NAME=FreeDraw
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freedraw
DB_USERNAME=freedraw
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is delivered through AWS SES. Use "log" locally to write emails to the
# log file instead of sending them. The SES credentials are configured below.
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="no-reply@freedraw.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AWS SES — falls back to the shared AWS credentials above when left empty.
# Set these only if SES uses different credentials or a different region.
AWS_SES_KEY=
AWS_SES_SECRET=
AWS_SES_REGION=us-east-1

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Realtime collaboration (Hocuspocus). Leave COLLAB_ENABLED off to keep the
# single-writer PATCH sync; turning it on gates the realtime-token endpoints so
# the browser connects through the Hocuspocus provider instead. COLLAB_SECRET
# signs the short-lived realtime tokens and must match the Hocuspocus service.
# Set VITE_COLLAB_ENABLED to the same value (build-time) and VITE_COLLAB_URL to
# the browser-facing WebSocket endpoint (e.g. wss://your-host/collab).
COLLAB_ENABLED=false
COLLAB_SECRET=
COLLAB_TOKEN_TTL=60
# Server-to-server channel into the Hocuspocus service. COLLAB_INTERNAL_URL is
# the private base URL of that service (e.g. http://hocuspocus:1234) and
# COLLAB_INTERNAL_SECRET is the bearer secret both sides share. Version
# labelling folds the pending update log through it, and restoring a version
# fails loudly when it is unset or unreachable.
COLLAB_INTERNAL_URL=
COLLAB_INTERNAL_SECRET=
COLLAB_INTERNAL_TIMEOUT=10
VITE_COLLAB_ENABLED=false
VITE_COLLAB_URL=

API_VERSION=1.0.0
API_DOCS_EMAILS=
HORIZON_EMAILS=
